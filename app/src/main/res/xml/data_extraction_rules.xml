<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 起的云备份和换机迁移：同 backup_rules.xml，账号不带走。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="account.xml" />
    </device-transfer>
</data-extraction-rules>
