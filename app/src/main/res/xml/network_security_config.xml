<?xml version="1.0" encoding="utf-8"?>
<!-- 自建 FreshRSS / Miniflux 常在内网用 http，允许明文；图片也常是 http -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
